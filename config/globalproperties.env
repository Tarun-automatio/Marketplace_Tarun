# =========================================================================
# globalproperties.env
# -------------------------------------------------------------------------
# Central configuration for the Plan Materials automation.
# Edit the values below to change what the test targets.
#
# Rules:
#   - One KEY=VALUE per line
#   - Comments start with '#'
#   - Do NOT wrap values in quotes (dotenv strips them literally)
#   - Real shell environment variables (e.g. set via `$env:PLAN_MATERIALS_URL=...`)
#     always win over values in this file
# =========================================================================

# URL TEMPLATE — used per Excel row. `{state}` is replaced with the row's
# State value (lowercased). Example: State=AZ → https://.../medicare/az/materials
PLAN_MATERIALS_URL_TEMPLATE=https://pws-q1.molinahealthcare.com/medicare/{state}/materials

# URL OVERRIDE — leave EMPTY to derive each scope's URL from the template above.
# Set only when you want to force ONE fixed URL for every row (debugging).
PLAN_MATERIALS_URL=

# Year filter — leave EMPTY to run every year present in the data sheet.
# Set (e.g. `PLAN_MATERIALS_YEAR=2027`) to run only that year's rows.
PLAN_MATERIALS_YEAR=

# Accordion filter — leave EMPTY to run every accordion present in the data sheet.
# Set (e.g. `PLAN_MATERIALS_ACCORDION=Annual Notice of Change (ANOC)`) to run only
# rows for that accordion. Other common values:
#   Summary of Benefits (SB)
#   Evidence of Coverage (EOC)
PLAN_MATERIALS_ACCORDION=

# Run mode is controlled by the CLI, not this file:
#   npm test              -> headless (default)
#   npm run test:headed   -> headed (visible Chrome window)

# =========================================================================
# Drug / Pharmacy page (Requirement 2)
# -------------------------------------------------------------------------
# Same shape as PLAN_MATERIALS_* above but points at the drug page.
# Example: State=NE → https://.../medicare/ne/drugs
# =========================================================================

DRUG_URL_TEMPLATE=https://pws-q1.molinahealthcare.com/medicare/{state}/drugs

# Set only if you want to force ONE fixed URL (debugging). Empty = per-state.
DRUG_URL=

# Optional filters — empty = every year / accordion present in the data sheet.
# Common drug accordions:
#   Comprehensive Formulary
#   Prior Authorization Grid
#   Step Therapy Grid
#   Formulary Change Notice
DRUG_YEAR=
DRUG_ACCORDION=

# =========================================================================
# Marketplace page (Requirement 3)
# -------------------------------------------------------------------------
# Marketplace flow: Home → Member Resources → Forms & Documents → select
# state → verify default coverage year → toggle year → verify URL param.
# =========================================================================

# Marketplace home URL. Q3 environment by default.
MARKETPLACE_URL=https://pws-q3.molinahealthcare.com/

# 2-letter state code the test selects in the Forms & Documents dropdown.
# Must match a value in the state <select> (e.g. tx, ca, az, mi, ...).
MARKETPLACE_STATE=tx

# Default and alternate coverage years the test verifies.
MARKETPLACE_DEFAULT_YEAR=2026
MARKETPLACE_ALTERNATE_YEAR=2027
