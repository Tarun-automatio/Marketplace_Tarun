# =========================================================================
# globalproperties.env
# -------------------------------------------------------------------------
# Central configuration for the Plan Materials automation.
# Edit the values below to change what the test targets.
#
# Rules:
#   - One KEY=VALUE per line
#   - Comments start with '#'
#   - Do NOT wrap values in quotes (dotenv strips them literally)
#   - Real shell environment variables (e.g. set via `$env:PLAN_MATERIALS_URL=...`)
#     always win over values in this file
# =========================================================================

# URL TEMPLATE — used per Excel row. `{state}` is replaced with the row's
# State value (lowercased). Example: State=AZ → https://.../medicare/az/materials
PLAN_MATERIALS_URL_TEMPLATE=https://pws-q1.molinahealthcare.com/medicare/{state}/materials

# URL OVERRIDE — leave EMPTY to derive each scope's URL from the template above.
# Set only when you want to force ONE fixed URL for every row (debugging).
PLAN_MATERIALS_URL=

# Year filter — leave EMPTY to run every year present in the data sheet.
# Set (e.g. `PLAN_MATERIALS_YEAR=2027`) to run only that year's rows.
PLAN_MATERIALS_YEAR=

# Accordion filter — leave EMPTY to run every accordion present in the data sheet.
# Set (e.g. `PLAN_MATERIALS_ACCORDION=Annual Notice of Change (ANOC)`) to run only
# rows for that accordion. Other common values:
#   Summary of Benefits (SB)
#   Evidence of Coverage (EOC)
PLAN_MATERIALS_ACCORDION=

# Run mode is controlled by the CLI, not this file:
#   npm test              -> headless (default)
#   npm run test:headed   -> headed (visible Chrome window)

# =========================================================================
# Drug / Pharmacy page (Requirement 2)
# -------------------------------------------------------------------------
# Same shape as PLAN_MATERIALS_* above but points at the drug page.
# Example: State=NE → https://.../medicare/ne/drugs
# =========================================================================

DRUG_URL_TEMPLATE=https://pws-q1.molinahealthcare.com/medicare/{state}/drugs

# Set only if you want to force ONE fixed URL (debugging). Empty = per-state.
DRUG_URL=

# Optional filters — empty = every year / accordion present in the data sheet.
# Common drug accordions:
#   Comprehensive Formulary
#   Prior Authorization Grid
#   Step Therapy Grid
#   Formulary Change Notice
DRUG_YEAR=
DRUG_ACCORDION=

# =========================================================================
# Marketplace page (Requirement 3)
# -------------------------------------------------------------------------
# Marketplace flow: Home → Member Resources → Forms & Documents → select
# state → verify default coverage year → toggle year → verify URL param.
# =========================================================================

# Marketplace home URL. Q3 environment by default.
MARKETPLACE_URL=https://pws-q3.molinahealthcare.com/

# 2-letter state code the test selects in the Forms & Documents dropdown.
# Must match a value in the state <select> (e.g. tx, ca, az, mi, ...).
MARKETPLACE_STATE=tx

# Default and alternate coverage years the test verifies.
MARKETPLACE_DEFAULT_YEAR=2026
MARKETPLACE_ALTERNATE_YEAR=2027

# =========================================================================
# Marketplace Plan Search — SBC negative check
# -------------------------------------------------------------------------
# After the positive SOB search flow, the spec applies the SBC Category
# filter and re-searches the same PlanName. Zero result cards is expected
# — that PROVES SBC is not exposed on the public UI. Set to false to skip.
# =========================================================================
MARKETPLACE_PLANS_NEGATIVE_SBC=true
MARKETPLACE_PLANS_SBC_AUDIENCE=Marketplace
MARKETPLACE_PLANS_SBC_CATEGORY=Summary of Benefits

# =========================================================================
# Marketplace Sitecore Docs (Requirement 2 — SBC / EOC / OOC)
# -------------------------------------------------------------------------
# Directly hit each Sitecore-hosted plan document PDF URL from the data
# sheet and verify Chrome renders it + the filename matches. No Member
# Resources navigation, no filters — pure URL validation.
# =========================================================================

# Doc-types to include. Requirement scope is SBC / EOC / OOC; add SOB if
# you want to reuse the same sheet for SOB verification too.
MARKETPLACE_SITECORE_DOCS_TYPES=SBC,EOC,OOC

# Languages to include (English + Spanish by default).
MARKETPLACE_SITECORE_DOCS_LANGS=en,es

# Optional filters — leave empty to run every row/doc-type/language.
MARKETPLACE_SITECORE_DOCS_STATE=
MARKETPLACE_SITECORE_DOCS_DOCTYPE=
MARKETPLACE_SITECORE_DOCS_LANGUAGE=
MARKETPLACE_SITECORE_DOCS_PLAN=

# Excel URLs from SharePoint use the prod host. Tests target Q3 by
# default — the loader swaps the host at run time. Set target to
# `www.molinahealthcare.com` to point tests at prod.
MARKETPLACE_SITECORE_DOCS_SOURCE_HOST=www.molinahealthcare.com
MARKETPLACE_SITECORE_DOCS_TARGET_HOST=pws-q3.molinahealthcare.com

# =========================================================================
# Marketplace Brochure & Formulary (Requirement 2b — Formulary + Member
# Brochure + Broker Brochure, all via Marketplace Forms & Documents filters)
# -------------------------------------------------------------------------
# Two filter passes per language on the Forms & Documents page:
#   1. Audience=Marketplace, Category=Formulary and Drug Lists
#   2. Audience=Marketplace, Category=Member Handbooks and Coverage
#      (Member Brochure + Broker Brochure both surface under this filter)
# =========================================================================

# App URL — UAT by default. Override to point at Q3, Q1 or prod.
MARKETPLACE_BROCHURE_FORMULARY_URL=https://uat-pws.molinahealthcare.com/

# Optional matrix filters — narrow the run without editing the sheet.
MARKETPLACE_BROCHURE_FORMULARY_STATE=
MARKETPLACE_BROCHURE_FORMULARY_YEAR=

# Filter labels — override only if the UI copy shifts.
MARKETPLACE_BROCHURE_FORMULARY_AUDIENCE=Marketplace
MARKETPLACE_BROCHURE_FORMULARY_CATEGORY_FORM=Formulary and Drug Lists
MARKETPLACE_BROCHURE_FORMULARY_CATEGORY_BROCH=Member Handbooks and Coverage

# Languages to include.
MARKETPLACE_BROCHURE_FORMULARY_LANGS=en,es

# Set to false to skip the Broker Brochure direct-URL checks entirely.
MARKETPLACE_BROCHURE_FORMULARY_BROKER_ENABLED=true

# Host swap (same trick as the Sitecore Docs suite).
MARKETPLACE_BROCHURE_FORMULARY_SOURCE_HOST=www.molinahealthcare.com
MARKETPLACE_BROCHURE_FORMULARY_TARGET_HOST=uat-pws.molinahealthcare.com
