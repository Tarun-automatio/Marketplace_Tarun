{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "Standalone Playwright framework for Molina Marketplace (IFP) validation — coverage-year toggle, plan search PDFs, and drug page external CTA links.",
  "main": "index.js",
  "scripts": {
    "clean:artifacts": "node hooks/globalSetup.js",
    "config:show": "node -e \"console.log(JSON.stringify(require('./config/framework.config'), null, 2))\"",
    "test": "playwright test tests/marketplace/marketplace.spec.js",
    "test:headed": "playwright test tests/marketplace/marketplace.spec.js --workers=1 --headed",
    "test:marketplace": "playwright test tests/marketplace/marketplace.spec.js",
    "test:marketplace:headed": "playwright test tests/marketplace/marketplace.spec.js --workers=1 --headed",
    "test:marketplace:plans": "playwright test tests/marketplace/marketplacePlanSearch.spec.js",
    "test:marketplace:plans:headed": "playwright test tests/marketplace/marketplacePlanSearch.spec.js --workers=1 --headed",
    "test:marketplace:pharmacy": "playwright test tests/marketplace/marketplaceDrugPharmacy.spec.js",
    "test:marketplace:pharmacy:headed": "playwright test tests/marketplace/marketplaceDrugPharmacy.spec.js --workers=1 --headed",
    "test:marketplace:docs": "playwright test tests/marketplace/marketplaceSitecoreDocs.spec.js",
    "test:marketplace:docs:headed": "playwright test tests/marketplace/marketplaceSitecoreDocs.spec.js --workers=1 --headed",
    "test:marketplace:brochure": "playwright test tests/marketplace/marketplaceBrochureFormulary.spec.js",
    "test:marketplace:brochure:headed": "playwright test tests/marketplace/marketplaceBrochureFormulary.spec.js --workers=1 --headed",
    "data:sitecore-docs": "node scripts/createSitecoreDocsExcel.js",
    "data:brochure-formulary": "node scripts/createBrochureFormularyExcel.js",
    "report:regen:docs": "node scripts/regenSitecoreDocsReports.js",
    "report:regen:brochure": "node scripts/regenBrochureFormularyReports.js",
    "test:all": "playwright test",
    "report:open": "start reports/marketplace-toggleCheck/"
  },
  "keywords": [
    "playwright",
    "automation",
    "molina",
    "marketplace",
    "pdf-validation"
  ],
  "author": "Molina QA Automation",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "dotenv": "^17.3.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  }
}
